PORT=4400
PUBLIC_SITE_URL=http://localhost:4400
PGHOST=localhost
PGPORT=5432
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
PGDATABASE=aversa44_db
SESSION_SECRET=replace_with_a_unique_random_secret
TICKET_HMAC_SECRET=replace_with_another_unique_random_secret
# Set to 1 only after configuring and testing QRIS PayMTI.
QBIZ_ENABLED=0
QBIZ_BASE_URL=http://localhost:8000
QBIZ_API_KEY=
QBIZ_MERCHANT_ID=
QBIZ_WEBHOOK_SECRET=replace_with_qbiz_webhook_secret
XENDIT_CALLBACK_TOKEN=replace_with_xendit_callback_token
# For the first startup with an empty production database only:
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# GOWA incoming message webhook, shared secret also configured on GOWA.
WHATSAPP_BOT_PHONE=
WHATSAPP_WEBHOOK_SECRET=
GOWA_SESSION_ID=

# Outgoing replies to customer-initiated verification messages.
GOWA_BASE_URL=
GOWA_USERNAME=
GOWA_PASSWORD=
# Set to 1 only for a trusted Tailscale connection during local development.
GOWA_ALLOW_TAILNET_HTTP=0

# Local testing only; never enable on a public deployment.
ALLOW_INSECURE_LOCAL_DEV=0

# Production requires exact proxy peer IPs, and live Turnstile keys.
TRUSTED_PROXY_IPS=
TURNSTILE_ENABLED=1
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random 32-byte key encoded as 64 hexadecimal characters; keep stable.
CLOUD_STREAM_ENCRYPTION_KEY=

# S3 Compatible Object Storage (for payment proof uploads)
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=aversa-media
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PATH_STYLE=true
